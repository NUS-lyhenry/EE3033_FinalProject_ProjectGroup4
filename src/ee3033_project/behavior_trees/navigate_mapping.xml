<!-- Follow the validated mapping path and complete at the frontier position. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="NavigateWithReplanning">
      <RateController hz="1.0">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="MappingTangent"/>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="mapping_goal_checker"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
